generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberType {
  EMPLOYEE
  CONTRACTOR
  FREELANCER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VARIABLE_HOURS
  ZERO_HOURS
}

enum LeaveCategory {
  PAID
  UNPAID
  STATUTORY
}

enum BankHolidayRegion {
  ENGLAND_WALES
  SCOTLAND
  NORTHERN_IRELAND
}

enum DataResidency {
  UK
  EU
  US
}

enum SubscriptionPlan {
  TRIAL
  FREE
  STARTER
  GROWTH
  SCALE
  PRO
  LOCKED
}

model Organization {
  id                      String            @id @default(cuid())
  name                    String
  slug                    String            @unique
  onboardingCompleted     Boolean           @default(false)
  ukBankHolidayInclusive  Boolean           @default(true)
  ukBankHolidayRegion     BankHolidayRegion @default(ENGLAND_WALES)
  ukCarryOverEnabled      Boolean           @default(false)
  ukCarryOverMax          Int               @default(0)
  ukCarryOverExpiryMonth  Int               @default(3)
  ukCarryOverExpiryDay    Int               @default(31)
  /// When the leave year starts (src/lib/leave-year.ts). Default 1 January.
  leaveYearStartMonth     Int               @default(1)
  leaveYearStartDay       Int               @default(1)
  dataResidency           DataResidency     @default(UK)
  maxAdminUsers           Int               @default(2)
  plan                    SubscriptionPlan  @default(TRIAL)
  fullTimeHoursPerWeek    Decimal           @default(37.5) @db.Decimal(4, 1)
  regionsEnabled          Boolean           @default(false)
  industry                String?
  stripeCustomerId        String?           @unique
  stripeSubscriptionId    String?           @unique
  stripePriceId           String?
  subscriptionStatus      String?
  trialEndsAt             DateTime?
  cardAdded               Boolean           @default(false)
  cancelAtPeriodEnd       Boolean           @default(false)
  currentPeriodEnd        DateTime?
  trialExpiredGraceEndsAt DateTime?
  deletionRequestedAt     DateTime?
  deletionScheduledFor    DateTime?
  deletionConfirmedAt     DateTime?
  deletionReason          String?
  // Timestamp of the one-off founder outreach email. Used to (a) gate the
  // limited-volume outreach (first N orgs only) and (b) prevent
  // double-sends on re-verification.
  founderEmailSentAt      DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  users            User[]
  leaveTypes       LeaveType[]
  publicHolidays   PublicHoliday[]
  bankHolidays     BankHoliday[]
  jiraIntegration  JiraIntegration?
  jiraUserMappings JiraUserMapping[]
  slackIntegration SlackIntegration?
  regions          Region[]
  coverOffers      CoverOffer[]

  @@index([deletionScheduledFor])
  @@index([trialExpiredGraceEndsAt])
}

model User {
  id                        String         @id @default(cuid())
  email                     String         @unique
  emailVerified             DateTime?
  name                      String
  passwordHash              String
  role                      Role           @default(MEMBER)
  memberType                MemberType     @default(EMPLOYEE)
  employmentType            EmploymentType @default(FULL_TIME)
  daysWorkedPerWeek         Float          @default(5)
  fteRatio                  Float          @default(1)
  qualifyingDaysPerWeek     Int            @default(5)
  averageWeeklyEarnings     Decimal?       @db.Decimal(8, 2)
  bradfordScore             Float          @default(0)
  countryCode               String         @default("NG")
  workCountry               String?
  isActive                  Boolean        @default(true)
  /// The day they left. Leavers keep their records (holiday records must be
  /// kept for 6 years) but can't sign in; data retention removes them later.
  leftOn                    DateTime?      @db.Date
  rightToWorkVerified       Boolean?
  /// Latest right-to-work check, kept in step with RightToWorkCheck
  /// (src/lib/right-to-work.ts). Expires on: null = no time limit.
  rightToWorkCheckedOn      DateTime?      @db.Date
  rightToWorkExpiresOn      DateTime?      @db.Date
  /// Written opt-out of the 48-hour average (WTR reg. 5): signed on, and
  /// until (null = no end date). src/lib/working-time.ts.
  workingTimeOptOutFrom     DateTime?      @db.Date
  workingTimeOptOutUntil    DateTime?      @db.Date
  department                String?
  serviceStartDate          DateTime?
  ukParentalLeaveChildCount Int            @default(0)
  digestOptOut              Boolean        @default(false)
  organizationId            String
  regionId                  String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region                  Region?                  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  leaveRequests           LeaveRequest[]           @relation("UserLeaveRequests")
  reviewedLeaves          LeaveRequest[]           @relation("ReviewerLeaveRequests")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  jiraUserMapping         JiraUserMapping?
  jiraConnections         JiraIntegration[]        @relation("JiraConnectedBy")
  slackConnections        SlackIntegration[]       @relation("SlackConnectedBy")
  weeklyHours             UserWeeklyHours[]
  carryOverBalances       LeaveCarryOverBalance[]
  children                Child[]
  rightToWorkChecks       RightToWorkCheck[]
  weeklyEarnings          WeeklyEarning[]
  regionHistory           UserRegionHistory[]      @relation("UserRegionHistorySubject")
  regionChangesMade       UserRegionHistory[]      @relation("UserRegionHistoryActor")
  coverOverrides          LeaveRequest[]           @relation("CoverOverrideBy")
  workPatterns            WorkPattern[]
  fitNotesRecorded        FitNote[]                @relation("FitNoteRecordedBy")
  coverOffersReceived     CoverOffer[]             @relation("CoverOfferTo")
  coverOffersSent         CoverOffer[]             @relation("CoverOfferBy")

  @@index([organizationId, countryCode])
  @@index([organizationId, workCountry, isActive])
  @@index([regionId])
  @@index([organizationId, regionId])
}

model LeaveType {
  id               String             @id @default(cuid())
  name             String
  color            String
  isPaid           Boolean            @default(true)
  category         LeaveCategory      @default(PAID)
  defaultDays      Int
  /// What defaultDays / policy allowances count. WEEKS means "weeks of their
  /// normal working week" (statutory family leave), converted per person.
  allowanceUnit    LeaveAllowanceUnit @default(DAYS)
  requiresEvidence Boolean            @default(false)
  minNoticeDays    Int                @default(0)
  durationLogic    String?
  countryCode      String?
  applyProRata     Boolean            @default(false)
  organizationId   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests     LeaveRequest[]
  leavePolicies     LeavePolicy[]
  carryOverBalances LeaveCarryOverBalance[]

  @@unique([name, organizationId])
}

model LeavePolicy {
  id              String   @id @default(cuid())
  countryCode     String
  annualAllowance Int
  carryOverMax    Int      @default(0)
  leaveTypeId     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([countryCode, leaveTypeId])
}

model LeaveRequest {
  id                       String      @id @default(cuid())
  startDate                DateTime
  endDate                  DateTime
  status                   LeaveStatus @default(PENDING)
  note                     String?
  userId                   String
  leaveTypeId              String
  reviewedById             String?
  reviewedAt               DateTime?
  evidenceProvided         Boolean     @default(false)
  kitDaysUsed              Int         @default(0)
  splitDaysUsed            Int         @default(0)
  // Hours this request deducts from an irregular/zero-hours worker's
  // hours-based holiday balance. NULL = day-based (all other workers/leave),
  // counted via countWeekdays() as before.
  hoursBooked              Float?
  sicknessNote             String?
  childBirthDate           DateTime?   @db.Date
  // Expected week of childbirth (due date) for maternity — drives the SMP
  // 26-week continuous-service / qualifying-week eligibility test.
  expectedDueDate          DateTime?   @db.Date
  /// Adoption: the date the adopter was told they'd been matched with the
  /// child. Its Sunday–Saturday week (the matching week) drives the SAP
  /// service test and earnings period (src/lib/smp-dates.ts).
  matchedDate              DateTime?   @db.Date
  splCurtailmentConfirmed  Boolean     @default(false)
  /// Shared parental leave: the employee's notice claims Statutory Shared
  /// Parental Pay for these weeks (SPL can be up to 50 weeks, ShPP at most
  /// 37, so some blocks are unpaid). The due date or matching date on the
  /// request sets the qualifying or matching week for the rate.
  shppClaimed              Boolean     @default(false)
  dailyHolidayPayRate      Decimal?    @db.Decimal(10, 2)
  sspDaysPaid              Int         @default(0)
  sspLimitReached          Boolean     @default(false)
  /// SSP per qualifying day (HMRC truncates to 4 decimal places), captured
  /// when the absence is booked or its dates change.
  sspDailyRate             Decimal?    @db.Decimal(10, 4)
  /// Average weekly earnings the SSP rate was worked out from (8 weeks
  /// before the absence); null when no pay was recorded, so the flat rate
  /// applied.
  sspAverageWeeklyEarnings Decimal?    @db.Decimal(10, 2)
  /// SMP for maternity, SAP for adoption (same rates and phases); which one
  /// follows the leave type (birthPayKind in src/lib/smp-dates.ts).
  smpAverageWeeklyEarnings Decimal?    @db.Decimal(8, 2)
  smpPhase1EndDate         DateTime?   @db.Date
  smpPhase2EndDate         DateTime?   @db.Date
  smpPhase1WeeklyRate      Decimal?    @db.Decimal(8, 2)
  smpPhase2WeeklyRate      Decimal?    @db.Decimal(8, 2)
  coverOverride            Boolean     @default(false)
  coverOverrideById        String?
  coverOverrideAt          DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  user            User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  reviewedBy      User?     @relation("ReviewerLeaveRequests", fields: [reviewedById], references: [id])
  coverOverrideBy User?     @relation("CoverOverrideBy", fields: [coverOverrideById], references: [id])
  /// Unpaid parental leave is per child: which child this leave is for.
  childId         String?
  child           Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)

  fitNotes    FitNote[]
  coverOffers CoverOffer[]

  @@index([userId, status])
  @@index([userId, leaveTypeId])
  @@index([status, startDate, endDate])
}

/// A fit note (Statement of Fitness for Work) received for a sickness
/// absence. Dates only: no document and no medical details are stored.
model FitNote {
  id             String   @id @default(cuid())
  leaveRequestId String
  coversFrom     DateTime @db.Date
  coversTo       DateTime @db.Date
  receivedOn     DateTime @db.Date
  /// Null once the recording manager is deleted.
  recordedById   String?
  createdAt      DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("FitNoteRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([leaveRequestId])
}

model JiraIntegration {
  id                String   @id @default(cuid())
  cloudId           String
  siteUrl           String
  accessToken       String
  refreshToken      String
  tokenExpiresAt    DateTime
  organizationId    String   @unique
  connectedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation("JiraConnectedBy", fields: [connectedByUserId], references: [id])
}

model JiraUserMapping {
  id             String   @id @default(cuid())
  jiraAccountId  String
  jiraEmail      String
  userId         String   @unique
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model SlackIntegration {
  id                  String   @id @default(cuid())
  teamId              String   @unique
  teamName            String
  botToken            String
  botUserId           String?
  notificationChannel String   @default("#time-off")
  organizationId      String   @unique
  connectedByUserId   String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation("SlackConnectedBy", fields: [connectedByUserId], references: [id])

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  name           String
  date           DateTime
  countryCode    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([date, countryCode, organizationId])
}

model BankHoliday {
  id             String            @id @default(cuid())
  name           String
  date           DateTime
  region         BankHolidayRegion
  countryCode    String            @default("GB")
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([date, region, organizationId])
  @@index([organizationId, date])
}

model UserWeeklyHours {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime
  hoursWorked   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
}

model LeaveCarryOverBalance {
  id            String          @id @default(cuid())
  userId        String
  leaveTypeId   String
  leaveYear     Int
  /// Why it carried over; each reason has its own expiry (src/lib/carry-over.ts).
  reason        CarryOverReason @default(COMPANY_POLICY)
  daysCarried   Float
  daysRemaining Float
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([userId, leaveTypeId, leaveYear])
}

enum CarryOverReason {
  COMPANY_POLICY
  SICKNESS
  FAMILY_LEAVE
}

model WeeklyEarning {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime @db.Date
  grossEarnings Decimal  @db.Decimal(10, 2)
  hoursWorked   Decimal  @db.Decimal(6, 2)
  isZeroPayWeek Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actorEmail     String?
  actorRole      String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, resource])
}

model Region {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  minCover          Int      @default(1)
  // Whether minCover is enforced on Sat/Sun and on bank holidays. New regions
  // default on (shift teams staff these days); regions that predate the flags
  // were migrated to false to keep their old weekday-only behaviour.
  coverWeekends     Boolean  @default(true)
  coverBankHolidays Boolean  @default(true)
  color             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]
  history      UserRegionHistory[]
  shiftTypes   ShiftType[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

// A recurring shift within a region/team ("Early", "Night"). When a region has
// active shift types, cover is checked per shift instead of per day.
model ShiftType {
  id                String   @id @default(cuid())
  regionId          String
  name              String
  // Local (Europe/London) "HH:MM". endTime <= startTime means the shift ends
  // the next day; a shift always belongs to the date it starts on.
  startTime         String
  endTime           String
  // Minimum staff per weekday, Monday first (length 7). 0 = no minimum.
  minCoverByWeekday Int[]
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  region      Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  patterns    WorkPattern[]
  coverOffers CoverOffer[]

  @@unique([regionId, name])
  @@index([regionId])
}

// A member's recurring working pattern: one row per (shift, weekday). Rows are
// closed (effectiveTo) rather than deleted when a pattern changes, so past
// cover reports stay accurate.
model WorkPattern {
  id            String    @id @default(cuid())
  userId        String
  shiftTypeId   String
  // Monday = 0 … Sunday = 6.
  weekday       Int
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shiftTypeId, weekday])
}

model UserRegionHistory {
  id          String   @id @default(cuid())
  userId      String
  regionId    String?
  changedById String?
  notes       String?
  changedAt   DateTime @default(now())

  user      User    @relation("UserRegionHistorySubject", fields: [userId], references: [id], onDelete: Cascade)
  region    Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  changedBy User?   @relation("UserRegionHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId, changedAt])
  @@index([regionId, changedAt])
}

model DataDeletionAudit {
  id               String    @id @default(cuid())
  organizationId   String
  organizationName String
  adminEmail       String?
  event            String
  reason           String?
  scheduledFor     DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([event, createdAt])
}

enum CoverOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  /// The manager withdrew it.
  CANCELLED
  /// Someone else accepted first, or the shift stopped being short.
  FILLED
  /// They accepted, then dropped out before the shift.
  WITHDRAWN
}

/// A manager asking one person to cover one shift on one date. An accepted
/// offer puts that person on the shift for that date (see shiftCover.ts).
model CoverOffer {
  id             String           @id @default(cuid())
  organizationId String
  shiftTypeId    String
  date           DateTime         @db.Date
  userId         String
  offeredById    String?
  /// The absence that caused the gap, when the offer came from one.
  leaveRequestId String?
  status         CoverOfferStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftType    ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  user         User          @relation("CoverOfferTo", fields: [userId], references: [id], onDelete: Cascade)
  offeredBy    User?         @relation("CoverOfferBy", fields: [offeredById], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([shiftTypeId, date])
  @@index([userId, status])
}

enum LeaveAllowanceUnit {
  DAYS
  WEEKS
}

/// A child someone can take unpaid parental leave for: up to 18 weeks per
/// child before their 18th birthday, at most 4 weeks per child a year.
/// Only what the rules need is stored (data minimisation).
model Child {
  id                  String   @id @default(cuid())
  userId              String
  /// Optional first name or label so the parent can tell children apart.
  label               String?
  dateOfBirth         DateTime @db.Date
  /// Weeks of unpaid parental leave already taken for this child with
  /// previous employers (the 18 weeks are per child, not per job).
  weeksTakenElsewhere Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@index([userId])
}

/// A right-to-work check as the Home Office requires it recorded: the date,
/// how it was done and the outcome. Copies of the documents are kept by the
/// employer (during employment and 2 years after), not uploaded here.
model RightToWorkCheck {
  id             String            @id @default(cuid())
  userId         String
  checkedOn      DateTime          @db.Date
  method         RightToWorkMethod
  /// e.g. "UK passport", "Share code result", "BRP".
  documentType   String?
  /// false: the check found no right to work.
  hasRightToWork Boolean
  /// Time-limited permission ends; null = no time limit. Recheck before then.
  expiresOn      DateTime?         @db.Date
  notes          String?
  checkedById    String?
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkedOn])
}

enum RightToWorkMethod {
  ONLINE_SHARE_CODE
  MANUAL_DOCUMENTS
  IDENTITY_SERVICE_PROVIDER
}
